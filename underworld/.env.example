# Underworld local environment overrides
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and should never be committed.

# Auth
UNDERWORLD_API_KEY=dev-key

# Higgsfield platform API v2 credentials.
# Get these from https://cloud.higgsfield.ai/api-keys
UNDERWORLD_HIGGSFIELD_ENABLED=false
UNDERWORLD_HIGGSFIELD_KEY_ID=""
UNDERWORLD_HIGGSFIELD_KEY_SECRET=""
UNDERWORLD_HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Legacy Pixazo gateway (only used if KEY_ID/KEY_SECRET are empty).
# UNDERWORLD_HIGGSFIELD_CREDENTIAL=""
# UNDERWORLD_HIGGSFIELD_MODE=api

# Cost guards
UNDERWORLD_HIGGSFIELD_CREDIT_BUDGET_DAILY=100
UNDERWORLD_HIGGSFIELD_MAX_JOBS_PER_WORLD_PER_TICK=1

# Media durability: completed images/videos are downloaded to this directory
# so creations survive CDN expiry. Defaults to underworld/data/media_assets.
# UNDERWORLD_MEDIA_LOCAL_DIR=/path/to/media_backup

# Optional: override other defaults
# UNDERWORLD_DB_PATH=/path/to/underworld.db
# UNDERWORLD_KIMI_API_KEY=""
