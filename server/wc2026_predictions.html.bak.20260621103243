  .drawer.show { transform: translateX(0); }
  .drawer-header { padding: 18px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .drawer-header h2 { margin: 0; font-size: 17px; }
  .drawer-close { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--text-primary); cursor: pointer; font-size: 18px; }
  .drawer-tabs { display: flex; gap: 4px; padding: 10px 16px; border-bottom: 1px solid var(--border); overflow-x: auto; }
  .drawer-tab { padding: 7px 14px; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text-secondary); font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .drawer-tab.active { background: var(--surface-elevated); color: var(--accent); border-color: var(--border); }
  .drawer-body { flex: 1; overflow-y: auto; padding: 20px; }
  .drawer-section { margin-bottom: 24px; }
  .drawer-section h4 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }

  /* Arena 3D */
  .arena-3d {
    perspective: 1000px; height: 260px; display: grid; place-items: center; margin-bottom: 20px;
    background: radial-gradient(circle at center, rgba(47,128,255,0.08) 0%, transparent 70%);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
  }
  .arena-stage {
    width: 320px; height: 180px;
    transform-style: preserve-3d;
    transform: rotateX(20deg) rotateY(0deg);
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .arena-pitch {
    position: absolute; width: 280px; height: 140px;
    background: linear-gradient(180deg, rgba(34,60,35,0.9) 0%, rgba(26,48,28,0.9) 100%);
    border: 1px solid rgba(255,255,255,0.15);
    transform: rotateX(60deg);
    border-radius: 8px;
    box-shadow: 0 0 40px rgba(0,213,255,0.08);
  }
  .arena-pitch::before {
    content: ""; position: absolute; inset: 10px; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px;
  }
  .arena-center-line {
    position: absolute; left: 50%; top: 10px; bottom: 10px; width: 1px; background: rgba(255,255,255,0.2);
  }
  .arena-team {
    position: absolute; width: 70px; height: 70px; border-radius: 50%;
    background: var(--surface-elevated); border: 2px solid var(--border-strong);
    display: grid; place-items: center; font-size: 36px;
    box-shadow: 0 0 30px rgba(0,0,0,0.5);
    transform: translateZ(30px);
  }
  .arena-team.home { left: -20px; }
  .arena-team.away { right: -20px; }
  .arena-score {
    position: absolute; font-family: var(--font-condensed); font-size: 48px; font-weight: 700;
    color: #fff; text-shadow: 0 0 20px rgba(47,128,255,0.5);
    transform: translateZ(60px);
  }
  .arena-ring {
    position: absolute; width: 180px; height: 180px; border-radius: 50%;
    border: 3px solid transparent;
    border-top-color: var(--accent);
    border-right-color: var(--accent-glow);
    transform: translateZ(10px) rotateX(70deg);
    opacity: 0.7;
    animation: ringSpin 12s linear infinite;
  }
  .arena-info {
    position: absolute; bottom: 12px; left: 0; right: 0; text-align: center;
    font-size: 11px; color: var(--text-secondary);
  }

  /* Simulator */
  .sim-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  .sim-controls select, .sim-controls input {
    background: var(--surface-elevated); border: 1px solid var(--border); color: var(--text-primary);
    padding: 8px 12px; border-radius: var(--radius-sm); font-size: 12px;
  }
  .sim-controls button { margin-left: auto; }

  /* Mobile tray */
  .mobile-tray {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(13,19,32,0.96); border-top: 1px solid var(--border);
    backdrop-filter: blur(16px); z-index: 250;
    transform: translateY(calc(100% - 56px)); transition: transform .3s;
  }
  .mobile-tray.expanded { transform: translateY(0); }
  .mobile-tray-header {
    height: 56px; display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px; cursor: pointer; position:relative; z-index:1;
  }
  .tray-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.1; pointer-events:none; z-index:0; }
  .mobile-tray:hover .tray-video { opacity:0.18; }
  @media (min-width: 1101px) { .mobile-tray { display: none; } }

  /* Loading skeleton */
  .skeleton {
    position:relative; overflow:hidden;
    background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.05) 75%);
    background-size: 200% 100%; animation: shimmer 1.5s infinite;
    border-radius: 8px;
  }
  .skeleton-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.15; pointer-events:none; z-index:0; }
  .skeleton-card { height: 220px; margin-bottom: 16px; }

  /* Empty/error */
  .state-box { position:relative; overflow:hidden; text-align: center; padding: 40px 20px; color: var(--text-muted); border-radius:var(--radius); }
  .state-box-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.1; pointer-events:none; z-index:0; }
  .state-box-content { position:relative; z-index:1; }
  .state-box img { max-width: 200px; opacity: 0.7; margin-bottom: 16px; }
  .state-box h3 { color: var(--text-primary); margin-bottom: 6px; }

  /* Footer */
  .app-footer {
    position:relative; overflow:hidden;
    margin-top: 60px; padding: 40px 24px;
    border-top: 1px solid var(--border);
    background: rgba(7,10,18,0.8);
  }
  .footer-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.08; pointer-events:none; z-index:0; }
  .app-footer:hover .footer-video { opacity:0.15; }
  .footer-inner { position:relative; z-index:1; max-width: 1600px; margin: 0 auto; }
  .footer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; margin-bottom: 24px; }
  .footer-col h4 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .footer-col a { display: block; color: var(--text-secondary); text-decoration: none; font-size: 12.5px; margin-bottom: 6px; }
  .footer-col a:hover { color: var(--accent); }
  .disclaimer {
    background: rgba(245,165,36,0.06); border: 1px solid rgba(245,165,36,0.2);
    border-radius: var(--radius); padding: 16px; font-size: 12px; color: var(--text-secondary); line-height: 1.6;
  }
  .disclaimer a { color: var(--accent); }

  /* Responsive */
  @media (max-width: 900px) {
    .header-inner { flex-wrap: wrap; }
    .header-nav { display: none; }
    .fixture-row { grid-template-columns: 60px 1fr 80px; }
    .fixture-conf, .fixture-pick { display: none; }
    .bracket-rounds { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .pc-teams { flex-direction: column; gap: 10px; }
    .pc-team.away { flex-direction: row; text-align: left; }
    .pc-vs { display: none; }
    .pc-score { font-size: 32px; }
    .pc-body { grid-template-columns: 1fr; }
    .groups-grid { grid-template-columns: 1fr; }
    .news-grid { grid-template-columns: 1fr; }
    .drawer { width: 100%; }
  }

  .prediction-card { --card-img: none; }
  .prediction-card::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.12; border-radius:inherit; pointer-events:none; z-index:0; }
  .prediction-card > * { position:relative; z-index:1; }
  .pc-bg { position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.12; border-radius:inherit; pointer-events:none; z-index:0; }
  .prob-row { display:flex; align-items:center; gap:10px; margin:6px 0; font-size:12px; }
  .prob-row span:first-child { width:90px; color:var(--text-secondary); }
  .prob-row span:last-child { width:46px; text-align:right; font-weight:700; }
  .bar-wrap { flex:1; height:8px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden; }
  .bar { height:100%; border-radius:4px; }
  .qualified { background:rgba(53,208,127,0.06); }
  .group-card { position:relative; --card-img:none; }
  .group-card::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.10; border-radius:inherit; pointer-events:none; z-index:0; }
  .group-card > * { position:relative; z-index:1; }
  .group-header { position:relative; z-index:1; }
  .pts { font-weight:800; }
  .fixture-stage { margin-bottom:24px; }
  .fixture-stage h3 { font-size:13px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:10px; }
  .knockout-hero { height:220px; border-radius:var(--radius); position:relative; overflow:hidden; border:1px solid var(--border); margin-bottom:20px; --card-img:none; }
  .knockout-hero::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.25; }
  .knockout-hero-inner { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:20px; background:linear-gradient(180deg, transparent 0%, rgba(7,10,18,0.95) 100%); z-index:1; }
  .news-card { position:relative; --card-img:none; }
  .news-card::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.10; border-radius:inherit; pointer-events:none; z-index:0; }
  .news-card > * { position:relative; z-index:1; }
  .player-card { position:relative; --card-img:none; }
  .player-card::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.08; border-radius:inherit; pointer-events:none; z-index:0; }
  .player-card > * { position:relative; z-index:1; }
  .player-status { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; padding:3px 8px; border-radius:999px; border:1px solid; }
  .player-status.ok { color:var(--success); border-color:rgba(53,208,127,0.3); background:rgba(53,208,127,0.08); }
  .player-status.doubt { color:var(--warning); border-color:rgba(245,165,36,0.3); background:rgba(245,165,36,0.08); }
  .player-status.out { color:var(--risk); border-color:rgba(255,77,79,0.3); background:rgba(255,77,79,0.08); }
  .drawer-hero { height:220px; border-radius:var(--radius); position:relative; overflow:hidden; border:1px solid var(--border); margin-bottom:20px; --card-img:none; }
  .drawer-hero::after { content:""; position:absolute; inset:0; background:var(--card-img) center/cover no-repeat; opacity:0.25; }
  .section-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.35; pointer-events:none; }
  .has-video { position:relative; overflow:hidden; }
  .has-video::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg, rgba(7,10,18,0.85), rgba(7,10,18,0.4)); }
  .lab-hero { background: var(--card-img) center/cover no-repeat; }

  /* Interactive card videos */
  .card-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .35s; border-radius:inherit; pointer-events:none; z-index:0; }
  .card-video.active { opacity:0.22; }
  .prediction-card::after, .group-card::after, .news-card::after, .player-card::after { z-index:-1; }
  .lab-card, .accuracy-stat, .bracket-match { position:relative; overflow:hidden; }
  .lab-card > *:not(.card-video), .accuracy-stat > *:not(.card-video), .bracket-match > *:not(.card-video) { position:relative; z-index:1; }
  .section-header { position:relative; overflow:hidden; }
  .section-header > *:not(.section-header-video) { position:relative; z-index:1; }
  .section-header-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.12; pointer-events:none; z-index:0; transition:opacity .35s; }
  .section-header:hover .section-header-video { opacity:0.22; }
  .btn-video-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .25s; border-radius:inherit; pointer-events:none; z-index:0 !important; }
  .btn { position:relative; overflow:hidden; }
  .btn > *:not(.btn-video-bg) { position:relative; z-index:1; }
  .btn:hover .btn-video-bg { opacity:0.18; }
  @media (prefers-reduced-motion: reduce) {
    .card-video, .section-video, .section-header-video, .btn-video-bg, .bg-video, .skeleton-video, .tray-video, .footer-video, .state-box-video, .header-video { display:none; }
  }

  .drawer-hero-meta { position:absolute; top:16px; left:16px; z-index:1; font-size:11px; color:var(--text-secondary); background:rgba(0,0,0,0.4); padding:4px 10px; border-radius:999px; }
  .drawer-hero-score { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-family:var(--font-condensed); font-size:64px; font-weight:700; z-index:1; text-shadow:0 0 30px rgba(0,0,0,0.8); }
