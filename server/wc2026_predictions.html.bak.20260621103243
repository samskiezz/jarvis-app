<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content="Jarvis Match Centre — World Cup 2026 Prediction Intelligence. Live model predictions, score projections, risk ratings, late news and tournament impact." />
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self';" />
<title>Jarvis Match Centre · World Cup 2026 Prediction Intelligence</title>
<style>
  :root {
    --bg: #070A12;
    --surface: #101624;
    --surface-elevated: #151D2E;
    --surface-highlight: #1B2740;
    --border: rgba(255,255,255,0.08);
    --border-strong: rgba(255,255,255,0.14);
    --text-primary: #F7F9FC;
    --text-secondary: #AAB4C5;
    --text-muted: #6F7A8D;
    --accent: #2F80FF;
    --accent-glow: #00D5FF;
    --success: #35D07F;
    --warning: #F5A524;
    --risk: #FF4D4F;
    --shadow: 0 8px 32px rgba(0,0,0,0.45);
    --shadow-strong: 0 16px 48px rgba(0,0,0,0.55);
    --radius: 16px;
    --radius-sm: 10px;
    --font-primary: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --font-condensed: "Roboto Condensed", "Saira Condensed", Impact, sans-serif;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    @keyframes glow { 0%,100% { box-shadow: 0 0 20px rgba(47,128,255,0.15); } 50% { box-shadow: 0 0 40px rgba(47,128,255,0.35); } }
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
    @keyframes ringSpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  }

  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-primary);
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
    overflow-x: hidden;
  }
  body {
    background-image:
      radial-gradient(circle at 20% 0%, rgba(47,128,255,0.12) 0%, transparent 35%),
      radial-gradient(circle at 80% 10%, rgba(0,213,255,0.08) 0%, transparent 30%),
      linear-gradient(180deg, rgba(7,10,18,0.9) 0%, var(--bg) 100%),
      url('asset/mc_stadium_command_centre_bg.png');
    background-size: cover, cover, cover, cover;
    background-position: center top;
    background-attachment: fixed;
    background-repeat: no-repeat;
  }
  body::before {
    content: "";
    position: fixed; inset: 0;
    background: url('asset/mc_pitch_grid_overlay.png') center / cover no-repeat;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }
  .bg-video {
    position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0.04; pointer-events: none; z-index: -1; transition: opacity .5s;
  }
  @media (max-width: 700px) { .bg-video { display: none; } }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: var(--surface); }
  ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  /* Utilities */
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .hidden { display:none !important; }
  .flex { display: flex; }
  .items-center { align-items: center; }
  .justify-between { justify-content: space-between; }
  .gap-2 { gap: 8px; }
  .gap-3 { gap: 12px; }
  .gap-4 { gap: 16px; }
  .text-secondary { color: var(--text-secondary); }
  .text-muted { color: var(--text-muted); }
  .font-mono { font-family: var(--font-mono); }
  .font-condensed { font-family: var(--font-condensed); }

  /* Header */
  .app-header {
    position: sticky; top: 0; z-index: 200;
    background: rgba(7,10,18,0.82);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    overflow:hidden;
  }
  .app-header > *:not(.header-video) { position:relative; z-index:1; }
  .header-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.12; pointer-events:auto; z-index:0; transition:opacity .3s; }
  .app-header:hover .header-video { opacity:0.22; }
  .header-inner {
    max-width: 1600px; margin: 0 auto;
    padding: 12px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-glow));
    display: grid; place-items: center;
    font-weight: 800; font-size: 18px; color: #fff;
    box-shadow: 0 0 20px rgba(47,128,255,0.3);
  }
  .brand-text h1 { margin: 0; font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
  .brand-text span { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .header-nav { display: flex; gap: 6px; }
  .header-nav a, .header-nav button {
    background: transparent; border: 1px solid transparent;
    color: var(--text-secondary); font-size: 12.5px; font-weight: 600;
    padding: 7px 12px; border-radius: 999px; cursor: pointer; text-decoration: none;
    transition: all .2s;
  }
  .header-nav a:hover, .header-nav button:hover { background: var(--surface); color: var(--text-primary); }
  .header-nav a.active { background: var(--surface-elevated); color: var(--accent); border-color: var(--border-strong); }
  .header-actions { display: flex; align-items: center; gap: 10px; }
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    background: rgba(53,208,127,0.12); color: var(--success); border: 1px solid rgba(53,208,127,0.25);
  }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); animation: pulse 2s infinite; }
  .toggle-pill {
    display: flex; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 3px;
  }
  .toggle-pill button {
    border: none; background: transparent; color: var(--text-secondary); font-size: 11px; font-weight: 700;
    padding: 5px 12px; border-radius: 999px; cursor: pointer;
  }
  .toggle-pill button.active { background: var(--accent); color: #fff; }

  /* Live strip */
  .live-strip {
    background: rgba(16,22,36,0.92);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    position: sticky; top: 61px; z-index: 100;
    backdrop-filter: blur(12px);
  }
  .strip-inner { max-width: 1600px; margin: 0 auto; padding: 0 24px; }
  .strip-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
  .strip-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; }
  .strip-card {
    flex: 0 0 auto; width: 170px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 10px 12px; cursor: pointer; transition: all .2s; position: relative; overflow:hidden;
  }
  .strip-card > *:not(.card-video) { position:relative; z-index:1; }
  .strip-card:hover { transform: translateY(-2px); border-color: var(--border-strong); box-shadow: var(--shadow); }
  .strip-card.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 20px rgba(47,128,255,0.15); }
  .strip-card.live { border-color: rgba(53,208,127,0.4); }
  .strip-card.news::after {
    content: ""; position: absolute; top: -4px; right: -4px; width: 10px; height: 10px;
    background: var(--warning); border-radius: 50%; box-shadow: 0 0 10px var(--warning);
  }
  .strip-teams { display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 14px; }
  .strip-teams .flag { font-size: 22px; }
  .strip-score { font-family: var(--font-condensed); font-size: 20px; color: var(--text-primary); }
  .strip-meta { margin-top: 6px; display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-muted); }
  .strip-conf { color: var(--accent); font-weight: 700; }

  /* Layout */
  .app-shell { max-width: 1600px; margin: 0 auto; padding: 24px; position: relative; z-index: 1; }
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 1100px) {
    .main-grid { grid-template-columns: 1fr; }
  }

  /* Section headers */
  .section-header { margin-bottom: 16px; }
  .section-header h2 { margin: 0; font-size: 18px; font-weight: 700; }
  .section-header p { margin: 4px 0 0; font-size: 12.5px; color: var(--text-muted); }

  /* Cards */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: all .25s;
  }
  .card:hover { border-color: var(--border-strong); }

  /* Prediction cards */
  .match-feed { display: flex; flex-direction: column; gap: 16px; }
  .prediction-card {
    background: linear-gradient(180deg, rgba(21,29,46,0.95) 0%, rgba(16,22,36,0.95) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: all .25s;
  }
  .prediction-card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(47,128,255,0.4), transparent);
  }
  .prediction-card:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow-strong); }
  .prediction-card.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 30px rgba(47,128,255,0.12); }
  .prediction-card.high-risk { border-color: rgba(245,165,36,0.35); }
  .prediction-card.live { border-color: rgba(53,208,127,0.35); }
  .prediction-card.completed.correct { border-color: rgba(53,208,127,0.35); }
  .prediction-card.completed.incorrect { border-color: rgba(255,77,79,0.35); }

  .pc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
  .pc-kickoff { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .pc-status { display: flex; gap: 6px; }
  .pc-teams { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .pc-team { display: flex; align-items: center; gap: 12px; flex: 1; }
  .pc-team.away { flex-direction: row-reverse; text-align: right; }
  .pc-team .flag { font-size: 42px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); }
  .pc-team .name { font-size: 20px; font-weight: 700; }
  .pc-team .meta { font-size: 11px; color: var(--text-muted); }
  .pc-vs { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); padding: 0 12px; }
  .pc-score {
    font-family: var(--font-condensed); font-size: 42px; font-weight: 700;
    background: linear-gradient(180deg, #fff, #AAB4C5); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-align: center; min-width: 90px;
  }

  .pc-body { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  @media (max-width: 700px) { .pc-body { grid-template-columns: 1fr 1fr; } }
  .pc-metric { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; }
  .pc-metric-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 6px; }
  .pc-metric-value { font-size: 20px; font-weight: 700; }
  .pc-metric-sub { font-size: 11px; color: var(--text-secondary); margin-top: 4px; }
  .pc-reason { grid-column: 1 / -1; font-size: 12.5px; color: var(--text-secondary); line-height: 1.55; margin-top: 4px; }
  .pc-reason b { color: var(--text-primary); }
  .pc-actions { display: flex; gap: 10px; margin-top: 16px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 9px 16px; border-radius: var(--radius-sm); font-size: 12.5px; font-weight: 700;
    border: 1px solid var(--border); background: var(--surface-elevated); color: var(--text-primary);
    cursor: pointer; transition: all .2s;
  }
  .btn:hover { background: var(--surface-highlight); border-color: var(--border-strong); }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-primary:hover { background: #1a6fd6; box-shadow: 0 0 20px rgba(47,128,255,0.25); }
  .btn-ghost { background: transparent; color: var(--text-secondary); }
  .btn-ghost:hover { color: var(--text-primary); }
  .btn-sm { padding: 6px 12px; font-size: 11.5px; }

  /* Confidence ring */
  .confidence-ring {
    width: 52px; height: 52px; border-radius: 50%; position: relative;
    display: grid; place-items: center;
    background: conic-gradient(var(--accent) var(--p, 0%), rgba(255,255,255,0.08) 0);
  }
  .confidence-ring::before {
    content: ""; position: absolute; inset: 4px; border-radius: 50%; background: var(--surface);
  }
  .confidence-ring span { position: relative; font-size: 13px; font-weight: 800; font-family: var(--font-mono); }

  /* Risk badge */
  .risk-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700;
    border: 1px solid;
  }
  .risk-low { background: rgba(53,208,127,0.10); color: var(--success); border-color: rgba(53,208,127,0.25); }
  .risk-medium { background: rgba(245,165,36,0.10); color: var(--warning); border-color: rgba(245,165,36,0.25); }
  .risk-high { background: rgba(255,77,79,0.10); color: var(--risk); border-color: rgba(255,77,79,0.25); }

  /* Builder */
  .builder-sticky { position: sticky; top: 140px; }
  .builder-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .builder-header { padding: 16px 18px; border-bottom: 1px solid var(--border); }
  .builder-header h3 { margin: 0; font-size: 15px; }
  .builder-header p { margin: 4px 0 0; font-size: 11.5px; color: var(--text-muted); }
  .builder-body { padding: 16px 18px; }
  .builder-empty { text-align: center; padding: 24px 12px; color: var(--text-muted); font-size: 12px; }
  .builder-selection {
    display: flex; align-items: center; gap: 10px;
    padding: 10px; margin-bottom: 8px;
    background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .builder-selection .sel-flag { font-size: 22px; }
  .builder-selection .sel-text { flex: 1; }
  .builder-selection .sel-title { font-size: 12.5px; font-weight: 700; }
  .builder-selection .sel-meta { font-size: 10.5px; color: var(--text-muted); }
  .builder-selection .sel-remove {
    width: 22px; height: 22px; border-radius: 50%; border: none; background: rgba(255,77,79,0.15);
    color: var(--risk); cursor: pointer; font-size: 14px; line-height: 1;
  }
  .builder-metric { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 8px; }
  .builder-metric span:first-child { color: var(--text-muted); }
  .builder-metric span:last-child { font-weight: 700; }
  .builder-warning {
    background: rgba(245,165,36,0.08); border: 1px solid rgba(245,165,36,0.2);
    border-radius: var(--radius-sm); padding: 10px; font-size: 11.5px; color: var(--warning); margin-bottom: 10px;
  }
  .builder-actions { display: flex; gap: 8px; margin-top: 14px; }
  .builder-actions .btn { flex: 1; }

  /* Sections */
  .section { margin-top: 40px; }

  /* News feed */
  .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
  .news-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px; transition: all .2s;
  }
  .news-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .news-card.impact-high { border-color: rgba(245,165,36,0.35); }
  .news-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
  .news-match { font-size: 13px; font-weight: 700; }
  .news-time { font-size: 10.5px; color: var(--text-muted); }
  .news-body { font-size: 12.5px; color: var(--text-secondary); line-height: 1.55; margin-bottom: 10px; }
  .news-impact { display: flex; gap: 16px; font-size: 11px; }
  .news-impact span { color: var(--text-muted); }
  .news-impact b { color: var(--text-primary); }
  .news-impact .down { color: var(--risk); }
  .news-impact .up { color: var(--success); }

  /* Fixtures */
  .fixture-date { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 20px 0 10px; }
  .fixture-row {
    display: grid; grid-template-columns: 80px 1fr 120px 90px 100px;
    align-items: center; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    transition: background .15s;
  }
  .fixture-row:hover { background: rgba(255,255,255,0.02); }
  .fixture-time { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); }
  .fixture-match { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .fixture-match .flag { font-size: 20px; }
  .fixture-pick { font-size: 12px; font-weight: 700; }
  .fixture-conf { font-size: 11px; color: var(--text-muted); }
  .fixture-score { font-family: var(--font-condensed); font-size: 16px; font-weight: 700; text-align: right; }
  .fixture-result { text-align: right; font-size: 11px; }
  .fixture-result.correct { color: var(--success); }
  .fixture-result.incorrect { color: var(--risk); }

  /* Groups */
  .groups-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
  .group-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .group-header { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .group-header h4 { margin: 0; font-size: 14px; }
  .group-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .group-table th { text-align: left; padding: 8px 10px; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
  .group-table td { padding: 9px 10px; border-bottom: 1px solid var(--border); }
  .group-table tr:last-child td { border-bottom: none; }
  .group-table .team { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .group-table .flag { font-size: 18px; }
  .group-table .prob { color: var(--text-muted); font-family: var(--font-mono); }
  .group-table .q { color: var(--success); font-weight: 700; }
  .group-table .e { color: var(--risk); }

  /* Knockout */
  .bracket-rounds { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; overflow-x: auto; }
  .bracket-round { min-width: 160px; }
  .bracket-round h5 { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .bracket-match {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 10px; margin-bottom: 10px; font-size: 11.5px;
  }
  .bracket-team { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; }
  .bracket-team.winner { color: var(--success); font-weight: 700; }
  .bracket-prob { font-family: var(--font-mono); color: var(--text-muted); font-size: 10px; }

  /* Players */
  .player-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .player-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px; transition: all .2s;
  }
  .player-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .player-card.high-impact { border-color: rgba(245,165,36,0.3); }
  .player-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
  .player-name { font-size: 15px; font-weight: 700; }
  .player-team { font-size: 11px; color: var(--text-muted); }
  .player-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .player-meta-item { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 8px; }
  .player-meta-item div:first-child { font-size: 10px; color: var(--text-muted); }
  .player-meta-item div:last-child { font-size: 13px; font-weight: 700; }
  .player-note { font-size: 11.5px; color: var(--text-secondary); margin-top: 10px; line-height: 1.5; }

  /* Model lab */
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .lab-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; }
  .lab-card h4 { margin: 0 0 8px; font-size: 14px; }
