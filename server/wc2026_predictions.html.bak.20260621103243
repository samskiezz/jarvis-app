<script>
"use strict";
(function(){
  const ESCAPE_MAP = {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"};
  function esc(s){ return s==null?"":String(s).replace(/[&<>"']/g,c=>ESCAPE_MAP[c]); }
  function pct(n){ return (n==null?0:Math.round(Number(n)*100))+"%"; }
  function fmtDate(iso){ try{ const d=new Date(iso); return d.toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"}); }catch(e){ return esc(iso||""); } }
  function shortDate(iso){ try{ const d=new Date(iso); return d.toLocaleDateString(undefined,{month:"short",day:"numeric"}); }catch(e){ return ""; } }
  function timeOnly(iso){ try{ return new Date(iso).toLocaleTimeString(undefined,{hour:"2-digit",minute:"2-digit"}); }catch(e){ return ""; } }
  function teamCode(name){ return esc((name||"").split(" ").map(w=>w[0]).join("").slice(0,3).toUpperCase()); }
  function slug(name){ return (name||"").toLowerCase().replace(/[^a-z0-9]+/g,"_").replace(/^_|_$/g,""); }
  function pickClass(p){ if(p>=0.55) return "high"; if(p>=0.4) return "medium"; return "low"; }
  function riskLabel(p){ if(p>=0.55) return "Lower risk"; if(p>=0.4) return "Balanced"; return "Higher risk"; }
  function riskClass(p){ if(p>=0.55) return "risk-low"; if(p>=0.4) return "risk-medium"; return "risk-high"; }
  function barColor(p){ if(p>=0.55) return "var(--success)"; if(p>=0.4) return "var(--warning)"; return "var(--risk)"; }
  function probFor(m,p){ if(!p.predicted_wdl) return 0; return p.predicted_wdl==="H"?p.p_home:(p.predicted_wdl==="A"?p.p_away:p.p_draw); }

  const state = {
    matches: [], predictions: {}, news: [], players: [], injuries: {}, valueBets: [],
    activeModel: {}, modelSummary: {models:[]}, outright: {}, builder: [], view: "simple", scenario: {},
    drawerMatch: null, drawerTab: "overview"
  };
  const $ = id => document.getElementById(id);

  async function loadJson(path){ const r=await fetch(path); if(!r.ok) throw new Error(r.status+" "+path); return r.json(); }

  async function init(){
    try{
      const [fixtures, preds, news, profiles, values, active, audit] = await Promise.all([
        loadJson("data/wc2026_fixtures_all.json"),
        loadJson("data/wc2026_model_predictions.json"),
        loadJson("data/wc2026_late_news.json"),
        loadJson("data/wc2026_player_profiles_enriched.json"),
        loadJson("data/wc2026_value_bets.json"),
        loadJson("data/wc2026_active_model.json"),
        loadJson("data/wc2026_predictions_audit?summary=1").catch(()=>({models:[]}))
      ]);
      state.matches = (fixtures.matches||[]).map(m=>{ m._iso = m.kickoff_iso; return m; });
      state.predictions = preds.all_fixture_predictions || {};
      state.news = news.items||[];
      state.players = profiles.players||[];
      state.injuries = profiles.injury_list||{};
      state.valueBets = values.value_bets||[];
      state.activeModel = active;
      state.modelSummary = audit;
      state.outright = preds.tournament_outright||{};
      state.generated = preds.generated_at;
      $("header-updated").textContent = "Updated " + shortDate(state.generated);
      populateTeamFilter();
      renderAll();
      bindEvents();
    }catch(err){
      console.error(err);
      document.body.insertAdjacentHTML("afterbegin", `<div class="toast toast-risk" role="alert">Could not load match data. <a href="javascript:location.reload()">Retry</a></div>`);
    }
  }

  function getPred(n){ return state.predictions[String(n)] || {}; }

  function actualOutcome(m){
    if(!m.played || !m.result) return null;
    const parts = String(m.result).replace(/[–—]/g,"-").split("-").map(x=>parseInt(x,10));
    if(parts.length!==2 || isNaN(parts[0])||isNaN(parts[1])) return null;
    if(parts[0]>parts[1]) return "H"; if(parts[0]<parts[1]) return "A"; return "D";
  }

  function resultFromScenario(n){
    if(state.scenario[n]) return state.scenario[n];
    const m = state.matches.find(x=>x.n===n);
    return m && m.played ? m.result : null;
  }

  function renderAll(){
    renderStrip();
    renderFeed();
    renderFixtures();
    renderGroups();
    renderKnockouts();
    renderPlayers();
    renderModelLab();
    renderNews();
    renderBuilder();
  }

  const GLOBAL_VIDEOS = {
    stadium: "asset/mc_stadium_command_centre_video.mp4",
    model: "asset/mc_model_lab_video.mp4",
    bracket: "asset/mc_knockout_bracket_video.mp4"
  };
  const AVAILABLE_VIDEOS = new Set(Array.from({length:104},(_,i)=>i+1));
  function matchAsset(n){ return `asset/mc_match_${String(n).padStart(3,"0")}_hero.png`; }
  const TEAM_SLUG_ALIASES = { "USA": "united_states" };
  function teamSlug(t){ return TEAM_SLUG_ALIASES[t] || slug(t); }
  function teamAsset(t){ return `asset/mc_team_${teamSlug(t)}_hero.png`; }
  function matchVideo(n){ return AVAILABLE_VIDEOS.has(n) ? `asset/mc_match_${String(n).padStart(3,"0")}_video.mp4` : null; }
  function groupVideo(g){ return `asset/mc_group_${g.toLowerCase()}_video.mp4`; }
  function teamVideo(t){ return `asset/mc_team_${teamSlug(t)}_video.mp4`; }
  function cardVideo(video, poster){
    if(!video) return "";
    return `<video class="card-video" muted loop playsinline preload="none" poster="${poster}"><source src="${video}" type="video/mp4"></video>`;
  }
  function headerVideo(video, poster){
    if(!video) return "";
    return `<video class="section-header-video" autoplay muted loop playsinline preload="metadata" poster="${poster||''}" onerror="this.style.display='none'"><source src="${video}" type="video/mp4"></video>`;
  }
  function stateBox(inner){
    return `<div class="state-box"><video class="state-box-video" autoplay muted loop playsinline preload="metadata"><source src="asset/mc_model_lab_video.mp4" type="video/mp4"></video><div class="state-box-content">${inner}</div></div>`;
  }
  function btnVideo(video){
    if(!video) return "";
    return `<video class="btn-video-bg" muted loop playsinline preload="none"><source src="${video}" type="video/mp4"></video>`;
  }
  function wireCardVideos(){
    document.querySelectorAll(".btn:not([data-video-wired])").forEach(btn=>{
      btn.dataset.videoWired="1";
      const video = btn.classList.contains("btn-primary") ? GLOBAL_VIDEOS.model : GLOBAL_VIDEOS.stadium;
      btn.insertAdjacentHTML("afterbegin", btnVideo(video));
    });
    document.querySelectorAll(".card-video:not([data-wired])").forEach(v=>{
      v.dataset.wired="1";
      const card = v.closest(".prediction-card,.group-card,.news-card,.player-card,.lab-card,.accuracy-stat,.bracket-match,.builder-card");
      if(!card) return;
      const play=()=>{
        v.classList.add("active");
        if(v.preload==="none"){ v.preload="metadata"; v.load(); }
        v.play().catch(()=>{});
      };
      const pause=()=>{ v.classList.remove("active"); v.pause(); };
      card.addEventListener("mouseenter", play);
      card.addEventListener("mouseleave", pause);
      card.addEventListener("focusin", play);
      card.addEventListener("focusout", pause);
    });
    document.querySelectorAll(".btn-video-bg:not([data-wired])").forEach(v=>{
      v.dataset.wired="1";
      const btn=v.closest(".btn");
      if(!btn) return;
      const play=()=>v.play().catch(()=>{});
      const pause=()=>v.pause();
      btn.addEventListener("mouseenter", play);
      btn.addEventListener("mouseleave", pause);
      btn.addEventListener("focusin", play);
      btn.addEventListener("focusout", pause);
    });
  }
  new MutationObserver(wireCardVideos).observe(document.body, {childList:true, subtree:true});

  function renderStrip(){
    const now = new Date().toISOString();
    const upcoming = state.matches.filter(m=>!m.played && m._iso>now).sort((a,b)=>a._iso.localeCompare(b._iso)).slice(0,8);
    const c=$("strip-scroll");
    if(!upcoming.length){ c.innerHTML=`<div class="text-muted" style="padding:18px 8px;">No upcoming fixtures.</div>`; return; }
    c.innerHTML = upcoming.map(m=>{
      const p=getPred(m.n), prob=probFor(m,p);
      return `<div class="strip-card" tabindex="0" role="button" aria-label="Open ${esc(m.home)} v ${esc(m.away)}" onclick="JARVIS.openDrawer(${m.n})">
        ${cardVideo(matchVideo(m.n)||GLOBAL_VIDEOS.stadium, matchAsset(m.n))}
        <div class="strip-teams"><span>${esc(teamCode(m.home))}</span><span class="strip-score">${esc(p.predicted_score||"-")}</span><span>${esc(teamCode(m.away))}</span></div>
        <div class="strip-meta"><span>${esc(shortDate(m.kickoff_iso))}</span><span class="strip-conf">${pct(prob)}</span></div>
      </div>`;
    }).join("");
  }

  function predictionCard(m){
    const p=getPred(m.n);
    const outcome=actualOutcome(m);
    const predWdl=p.predicted_wdl;
    const predProb=probFor(m,p);
    const confClass=pickClass(predProb);
    const correct=outcome && predWdl===outcome;
    const value=state.valueBets.find(v=>v.match_n===m.n && v.value_bet);
    const inBuilder=state.builder.includes(m.n);
    const pickName = predWdl==="H"?m.home:(predWdl==="A"?m.away:"Draw");
    const statusHtml = m.played
      ? `<span class="risk-badge ${correct?"risk-low":"risk-high"}">${esc(m.result)} ${correct?"✓":"✗"}</span>`
      : `<span class="risk-badge risk-medium">${esc(timeOnly(m.kickoff_iso))}</span>`;
    const riskHtml = `<span class="risk-badge ${riskClass(predProb)}">${esc(riskLabel(predProb))}</span>`;
    const metrics = state.view==="pro" ? `
      <div class="pc-metric"><div class="pc-metric-label">${esc(m.home)} win</div><div class="pc-metric-value" style="color:${barColor(p.p_home)}">${pct(p.p_home)}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">Draw</div><div class="pc-metric-value">${pct(p.p_draw)}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">${esc(m.away)} win</div><div class="pc-metric-value" style="color:${barColor(p.p_away)}">${pct(p.p_away)}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">Treatment</div><div class="pc-metric-value" style="font-size:16px;">${esc(p.treatment||"-")}</div></div>`
      : `
      <div class="pc-metric"><div class="pc-metric-label">Model pick</div><div class="pc-metric-value" style="color:${barColor(predProb)}">${esc(pickName)}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">Confidence</div><div class="pc-metric-value">${pct(predProb)}</div><div class="pc-metric-sub">${esc(riskLabel(predProb))}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">Projected score</div><div class="pc-metric-value">${esc(p.predicted_score||"-")}</div></div>
      <div class="pc-metric"><div class="pc-metric-label">Edge</div><div class="pc-metric-value" style="color:${value?"var(--success)":"var(--text-muted)"}">${value?"+"+value.edge_pp.toFixed(1)+"pp":"None"}</div></div>`;
    const reason = `<div class="pc-reason">${esc(m.venue)} · ${esc(m.stage)} ${esc(m.group||"")}. The three-spread ensemble favours <b>${esc(pickName)}</b> (${pct(predProb)}). ${value?"A value edge was detected on the model side.":"No strong value edge vs the market sample."}</div>`;
    return `<article class="prediction-card ${m.played?(correct?"correct":"incorrect"):""} ${inBuilder?"selected":""}" style="--card-img:url('${matchAsset(m.n)}')" data-n="${esc(String(m.n))}">
      <div class="pc-bg" aria-hidden="true"></div>
      ${cardVideo(matchVideo(m.n)||GLOBAL_VIDEOS.stadium, matchAsset(m.n))}
      <div class="pc-header">
        <div class="pc-kickoff">${esc(fmtDate(m.kickoff_iso))}</div>
        <div class="pc-status">${statusHtml}${riskHtml}</div>
      </div>
      <div class="pc-teams">
        <div class="pc-team">
          <div class="flag" aria-hidden="true"></div>
          <div><div class="name">${esc(m.home)}</div><div class="meta">${esc(teamCode(m.home))}</div></div>
        </div>
        <div class="pc-vs">v</div>
        <div class="pc-team away">
          <div class="flag" aria-hidden="true"></div>
          <div><div class="name">${esc(m.away)}</div><div class="meta">${esc(teamCode(m.away))}</div></div>
        </div>
        <div class="pc-score">${esc(p.predicted_score||"-")}</div>
      </div>
      <div class="pc-body">${metrics}</div>
      ${reason}
      <div class="pc-actions">
        <button class="btn btn-sm ${inBuilder?"btn-ghost":"btn-primary"}" onclick="event.stopPropagation();JARVIS.${inBuilder?"removeFromBuilder":"addToBuilder"}(${m.n})">${inBuilder?"Remove from card":"Add to card"}</button>
        <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();JARVIS.openDrawer(${m.n})">Analysis</button>
        ${p.watch_link && p.watch_link.url ? `<a class="btn btn-ghost btn-sm" href="${esc(p.watch_link.url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${esc(p.watch_link.label || "Watch")}</a>` : ""}
      </div>
    </article>`;
  }

  function renderFeed(){
    const now = new Date().toISOString();
    const upcoming = state.matches.filter(m=>!m.played && m._iso>now).sort((a,b)=>a._iso.localeCompare(b._iso));
    const c=$("match-feed");
    if(!upcoming.length){ c.innerHTML=stateBox(`<h3>No upcoming matches</h3><p>The current window is empty.</p>`); return; }
    c.innerHTML = upcoming.slice(0,12).map(predictionCard).join("") +
      (upcoming.length>12 ? `<div style="text-align:center;margin-top:18px;"><button class="btn btn-ghost" onclick="JARVIS.showAllFixtures()">Show all ${upcoming.length} upcoming fixtures</button></div>` : "");
  }

  function showAllFixtures(){ document.getElementById("fixtures").scrollIntoView({behavior:"smooth"}); }

  function renderFixtures(){
    const byDate = {};
    state.matches.forEach(m=>{
      const d = shortDate(m.kickoff_iso) || "TBD";
      byDate[d]=byDate[d]||[]; byDate[d].push(m);
    });
    const c=$("fixtures-content");
    let html="";
    Object.keys(byDate).sort((a,b)=>{
      const da=state.matches.find(m=>shortDate(m.kickoff_iso)===a)._iso;
      const db=state.matches.find(m=>shortDate(m.kickoff_iso)===b)._iso;
      return da.localeCompare(db);
    }).forEach(date=>{
      html+=`<div class="fixture-date">${esc(date)}</div>`;
      html+=byDate[date].sort((a,b)=>a._iso.localeCompare(b._iso)).map(m=>{
        const p=getPred(m.n);
        const outcome=actualOutcome(m);
        const cls = m.played ? (outcome===p.predicted_wdl?"correct":"wrong") : "";
        const pick = p.predicted_wdl==="H"?m.home:(p.predicted_wdl==="A"?m.away:"Draw");
        return `<div class="fixture-row ${cls}" onclick="JARVIS.openDrawer(${m.n})">
          <div class="fixture-time">${esc(timeOnly(m.kickoff_iso))}</div>
          <div class="fixture-match"><span>${esc(m.home)}</span><span class="text-muted">v</span><span>${esc(m.away)}</span></div>
          <div class="fixture-pick">${esc(pick)} ${pct(probFor(m,p))}</div>
          <div class="fixture-score">${esc(m.result||p.predicted_score||"-")}</div>
          <div class="fixture-result ${cls}">${m.played?(outcome===p.predicted_wdl?"Correct":"Miss"):""}</div>
        </div>`;
      }).join("");
    });
    c.innerHTML=html;
  }

  function computeStandings(){
    const groups={};
    state.matches.filter(m=>m.stage==="GROUP").forEach(m=>{
      if(!groups[m.group]) groups[m.group]={};
      [m.home,m.away].forEach(t=>{ if(!groups[m.group][t]) groups[m.group][t]={team:t,P:0,W:0,D:0,L:0,GF:0,GA:0,GD:0,Pts:0}; });
      const res=resultFromScenario(m.n);
      if(res){
        const [hg,ag]=String(res).replace(/[–—]/g,"-").split("-").map(x=>parseInt(x,10));
        if(!isNaN(hg)&&!isNaN(ag)){
          const h=groups[m.group][m.home], a=groups[m.group][m.away];
          h.P++; a.P++; h.GF+=hg; h.GA+=ag; a.GF+=ag; a.GA+=hg;
          if(hg>ag){h.W++;a.L++;h.Pts+=3;}else if(hg<ag){a.W++;h.L++;a.Pts+=3;}else{h.D++;a.D++;h.Pts++;a.Pts++;}
        }
      }
    });
    return groups;
  }

  function renderGroups(){
    const groups=computeStandings();
    const c=$("groups-grid");
    const letters=Object.keys(groups).sort();
    if(!letters.length){ c.innerHTML=stateBox(`Group data unavailable.`); return; }
    c.innerHTML=letters.map(g=>{
      const rows=Object.values(groups[g]).sort((a,b)=>b.Pts-a.Pts||b.GD-a.GD||b.GF-a.GF);
      return `<div class="group-card" style="--card-img:url('asset/mc_group_${g.toLowerCase()}.png')">
        ${cardVideo(groupVideo(g)||GLOBAL_VIDEOS.stadium, `asset/mc_group_${g.toLowerCase()}.png`)}
        <div class="group-header"><h4>Group ${esc(g)}</h4><span class="text-muted">${rows.length} teams</span></div>
        <table class="group-table">
          <thead><tr><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>Pts</th></tr></thead>
          <tbody>${rows.map((r,i)=>`<tr class="${i<2?"qualified":""}"><td><div class="team"><span class="flag" aria-hidden="true"></span>${esc(r.team)}</div></td><td>${r.P}</td><td>${r.W}</td><td>${r.D}</td><td>${r.L}</td><td>${r.GD>0?"+":""}${r.GD}</td><td class="pts ${i<2?"q":"e"}">${r.Pts}</td></tr>`).join("")}</tbody>
        </table>
      </div>`;
    }).join("");
    const sel=$("sim-match");
    if(sel && !sel.dataset.populated){
      state.matches.filter(m=>m.stage==="GROUP" && !m.played).sort((a,b)=>a._iso.localeCompare(b._iso)).forEach(m=>{
        const opt=document.createElement("option"); opt.value=m.n; opt.textContent=`${m.group} · ${m.home} v ${m.away}`; sel.appendChild(opt);
      });
      sel.dataset.populated="1";
    }
  }

  function renderKnockouts(){
    const c=$("knockout-content");
    const rounds = ["R32","R16","QF","SF","FINAL"];
    const roundNames = {"R32":"Round of 32","R16":"Round of 16","QF":"Quarter-finals","SF":"Semi-finals","FINAL":"Final"};
    const upcoming = state.matches.filter(m=>m.stage!=="GROUP" && !m.played).sort((a,b)=>a._iso.localeCompare(b._iso));
    let html=`<div class="knockout-hero has-video" style="--card-img:url('asset/mc_knockout_bracket_wall.png')">
      <video class="section-video" autoplay muted loop playsinline poster="asset/mc_knockout_bracket_wall.png" onerror="this.style.display='none'"><source src="asset/mc_knockout_bracket_video.mp4" type="video/mp4"></video>
      <div class="knockout-hero-inner" style="position:relative;z-index:1"><h3>Tournament path projection</h3><p>Based on current group standings and model probabilities.</p></div>
    </div>`;
    html+=`<div class="bracket-rounds">`;
    rounds.forEach(r=>{
      const matches = state.matches.filter(m=>m.stage===r).sort((a,b)=>a._iso.localeCompare(b._iso));
      html+=`<div class="bracket-round"><h5>${esc(roundNames[r])}</h5>`;
      matches.slice(0,8).forEach(m=>{
        const p=getPred(m.n);
        const pick = p.predicted_wdl==="H"?m.home:(p.predicted_wdl==="A"?m.away:"Draw");
        html+=`<div class="bracket-match" onclick="JARVIS.openDrawer(${m.n})">
          ${cardVideo(GLOBAL_VIDEOS.bracket, 'asset/mc_knockout_bracket_wall.png')}
          <div class="bracket-team ${p.predicted_wdl==='H'?'winner':''}"><span>${esc(m.home)}</span><span class="bracket-prob">${pct(p.p_home)}</span></div>
          <div class="bracket-team ${p.predicted_wdl==='A'?'winner':''}"><span>${esc(m.away)}</span><span class="bracket-prob">${pct(p.p_away)}</span></div>
          <div style="margin-top:6px;font-size:10px;color:var(--text-muted);">Model advance: ${esc(pick)}</div>
        </div>`;
      });
      html+=`</div>`;
    });
    html+=`</div>`;
    if(upcoming.length){
      html+=`<div class="section-header" style="margin-top:24px;"><h3>Next knockout fixtures</h3></div>`;
      html+=upcoming.slice(0,4).map(m=>predictionCard(m)).join("");
    }
    c.innerHTML=html;
  }

  function populateTeamFilter(){
    const sel=$("player-team-filter");
    const teams=Array.from(new Set(state.players.map(p=>p.country))).sort();
    teams.forEach(t=>{ const opt=document.createElement("option"); opt.value=t; opt.textContent=t; sel.appendChild(opt); });
  }

  function renderPlayers(){
    const q=$("player-search").value.toLowerCase();
    const team=$("player-team-filter").value;
    const pos=$("player-pos-filter").value;
    const list=state.players.filter(p=>{
      const inj=state.injuries[p.name];
      const text=(p.name+" "+p.country+" "+p.club+" "+p.position).toLowerCase();
      return (!q||text.includes(q)) && (!team||p.country===team) && (!pos||p.position===pos);
    }).slice(0,60);
    const c=$("player-grid");
    if(!list.length){ c.innerHTML=stateBox(`No players match.`); return; }
    c.innerHTML=list.map(p=>{
      const inj=state.injuries[p.name];
      const status = inj ? `<span class="player-status ${inj.status==='out'?'out':'doubt'}">${esc(inj.status.toUpperCase())}</span>` : `<span class="player-status ok">Available</span>`;
      return `<div class="player-card ${inj?'high-impact':''}" style="--card-img:url('${teamAsset(p.country)}')">
        ${cardVideo(teamVideo(p.country)||GLOBAL_VIDEOS.stadium, teamAsset(p.country))}
        <div class="player-header"><div><div class="player-name">${esc(p.name)}</div><div class="player-team">${esc(p.country)} · ${esc(p.position)} · ${esc(p.club||"-")}</div></div>${status}</div>
        <div class="player-meta">
          <div class="player-meta-item"><div>Age</div><div>${p.age}</div></div>
          <div class="player-meta-item"><div>Caps</div><div>${p.caps}</div></div>
        </div>
        ${inj?`<div class="player-note"><b>${esc(inj.reason)}</b> — ${esc(inj.status)}. Check lineups closer to kickoff.</div>`:`<div class="player-note">No reported availability issues.</div>`}
      </div>`;
    }).join("");
  }

  function renderModelLab(){
    const c=$("lab-grid");
    const am=state.activeModel;
    const ew=am.ensemble_weights||{};
    const top = Object.entries(ew).filter(([_,v])=>v>0).sort((a,b)=>b[1]-a[1]).slice(0,4).map(([k,v])=>`${esc(k)} ${(v*100).toFixed(1)}%`).join(", ");
    c.innerHTML=`
      <div class="lab-card">${cardVideo('asset/mc_lab_active_model_video.mp4', 'asset/mc_model_lab_visual.png')}<div class="icon">📊</div><h4>Active model</h4><p>${esc(am.model_version||"v001")} — promoted ${esc(shortDate(am.created_at))}. Single-pick accuracy ${pct(am.single_pick_accuracy)}, three-spread coverage ${pct(am.three_spread_coverage)}.</p></div>
      <div class="lab-card">${cardVideo('asset/mc_lab_calibration_video.mp4', 'asset/mc_model_lab_visual.png')}<div class="icon">🎯</div><h4>Calibration</h4><p>Calibration error ${(am.calibration_error*100).toFixed(2)}pp. Drift detected: ${am.drift?.drift_detected?"Yes":"No"}. Recent accuracy ${pct(am.drift?.recent_accuracy)}.</p></div>
      <div class="lab-card">${cardVideo('asset/mc_lab_ensemble_video.mp4', 'asset/mc_model_lab_visual.png')}<div class="icon">⚖️</div><h4>Ensemble weights</h4><p>${top||"Uniform blend"}. Poisson × Dixon-Coles × Elo × group-table signals blended and draw-calibrated.</p></div>
      <div class="lab-card">${cardVideo('asset/mc_lab_transparency_video.mp4', 'asset/mc_model_lab_visual.png')}<div class="icon">🔒</div><h4>Transparency</h4><p>Every prediction is logged in the audit database. Use the audit endpoint to verify locked T-8h forecasts against results.</p></div>`;
    const models=state.modelSummary.models||[];
    const rows=models.slice(0,8);
    $("accuracy-grid").innerHTML=rows.map(r=>`
      <div class="accuracy-stat">
        ${cardVideo('asset/mc_lab_calibration_video.mp4', 'asset/mc_model_lab_visual.png')}
        <div class="v">${(r.winner_pct*100).toFixed(1)}%</div>
        <div class="k">${esc(r.model||"Model")}<br>${r.winner_hits||0}/${r.graded||0}</div>
      </div>`).join("") || stateBox(`No verified results yet.`);
  }

  function renderNews(){
    const c=$("news-grid");
    if(!state.news.length){ c.innerHTML=stateBox(`No late news items.`); return; }
    c.innerHTML=state.news.map((item,i)=>{
      const high = /out|injury|doubt|ruled|suspension/i.test(item.text);
      const newsPoster = i<6 ? `asset/mc_news_${String(i).padStart(2,'0')}.png` : "asset/mc_late_news_impact.png";
      const newsVid = i<6 ? `asset/mc_news_${String(i).padStart(2,'0')}_video.mp4` : GLOBAL_VIDEOS.stadium;
      return `<article class="news-card ${high?'impact-high':''}" ${i<6?`style="--card-img:url('${newsPoster}')"`:``}>
        ${cardVideo(newsVid, newsPoster)}
        <div class="news-header"><div class="news-match">${esc(item.player)}</div><div class="news-time">${esc(item.source)}</div></div>
        <div class="news-body">${esc(item.text)}</div>
        <div class="news-impact"><span>Impact: <b class="${high?'down':'up'}">${high?"Negative":"Neutral"}</b></span><a href="${esc(item.url)}" target="_blank" rel="noopener" class="btn btn-sm btn-ghost" onclick="event.stopPropagation()">Source</a></div>
      </article>`;
    }).join("");
  }

  function renderBuilder(){
    const body=$("builder-body");
    const tray=$("mobile-tray-body");
    $("tray-count").textContent=state.builder.length;
    if(!state.builder.length){
      const empty=`<div class="state-box"><video class="state-box-video" autoplay muted loop playsinline preload="metadata"><source src="asset/mc_builder_panel_video.mp4" type="video/mp4"></video><div class="state-box-content"><p>Select 2–6 predictions to compare confidence, risk and overlap.</p></div></div>`;
      body.innerHTML=empty; tray.innerHTML=empty; return;
    }
    let sum=0, count=0, html="";
    state.builder.forEach(n=>{
      const m=state.matches.find(x=>x.n===n); if(!m) return;
      const p=getPred(n); const prob=probFor(m,p);
      const label=p.predicted_wdl==="H"?m.home:(p.predicted_wdl==="A"?m.away:"Draw");
      sum+=prob; count++;
      html+=`<div class="builder-selection">
        <div class="sel-text"><div class="sel-title">${esc(m.home)} v ${esc(m.away)}</div><div class="sel-meta">${esc(label)} · ${pct(prob)} confidence</div></div>
        <button class="sel-remove" aria-label="Remove" onclick="JARVIS.removeFromBuilder(${n})">×</button>
      </div>`;
    });
    const avg=count?sum/count:0;
    const summary=`<div class="builder-warning">Combined average confidence: <b>${pct(avg)}</b> · ${esc(riskLabel(avg))}. More legs = lower hit rate.</div>`;
    body.innerHTML=summary+html;
    tray.innerHTML=summary+html;
  }

  function addToBuilder(n){ if(state.builder.includes(n)){ removeFromBuilder(n); return; } if(state.builder.length>=6){ alert("Card can hold up to 6 picks."); return; } state.builder.push(n); renderBuilder(); renderFeed(); }
  function removeFromBuilder(n){ state.builder=state.builder.filter(x=>x!==n); renderBuilder(); renderFeed(); }

  // ── Drawer ───────────────────────────────────────────────────────────────
  function openDrawer(n){
    state.drawerMatch=n; state.drawerTab="overview"; renderDrawer();
    $("drawer").classList.add("show"); $("drawer-backdrop").classList.add("show"); document.body.style.overflow="hidden";
  }
  function closeDrawer(){ $("drawer").classList.remove("show"); $("drawer-backdrop").classList.remove("show"); document.body.style.overflow=""; }
  function setDrawerTab(tab){ state.drawerTab=tab; renderDrawer(); }

  function renderDrawer(){
    const m=state.matches.find(x=>x.n===state.drawerMatch); if(!m) return;
    const p=getPred(m.n);
    $("drawer-title").textContent=`${m.home} v ${m.away}`;
    const tabs=["overview","probabilities","value","lineups","video"];
    $("drawer-tabs").innerHTML=tabs.map(t=>`<button class="drawer-tab ${state.drawerTab===t?'active':''}" onclick="JARVIS.setDrawerTab('${t}')">${esc(t[0].toUpperCase()+t.slice(1))}</button>`).join("");
    let body="";
    if(state.drawerTab==="overview"){
      body=`<div class="drawer-hero" style="--card-img:url('${matchAsset(m.n)}')">
        <div class="drawer-hero-meta">${esc(m.stage)} ${esc(m.group||"")} · ${esc(m.venue)}</div>
        <div class="drawer-hero-score">${esc(p.predicted_score||"-")}</div>
        <div class="drawer-hero-pick">Model pick: <b>${esc(p.predicted_wdl==="H"?m.home:(p.predicted_wdl==="A"?m.away:"Draw"))}</b> · ${pct(probFor(m,p))}</div>
      </div>`;
      const watch = p.watch_link && p.watch_link.url ? `<a class="btn btn-primary btn-sm" href="${esc(p.watch_link.url)}" target="_blank" rel="noopener" style="margin-top:12px;">${esc(p.watch_link.label || "Watch")}</a>` : "";
      body+=`<div class="drawer-section"><h4>Match notes</h4><p style="color:var(--text-secondary);line-height:1.6;">${esc(m.venue)}. Kickoff ${esc(fmtDate(m.kickoff_iso))}. The ensemble projects a ${esc(p.predicted_score||"close score")} result with the highest probability on ${esc(p.predicted_wdl==="H"?m.home:(p.predicted_wdl==="A"?m.away:"the draw"))}.</p>${watch}</div>`;
      body+=`<div class="drawer-section"><h4>Three-spread view</h4><div class="pc-body">`+
        ["A","B","C"].map(k=>{
          const pick=p.three_spread?.[k];
          const name = pick==="H"?m.home:(pick==="A"?m.away:(pick?"Draw":"No pick"));
          return `<div class="pc-metric"><div class="pc-metric-label">Spread ${k}</div><div class="pc-metric-value">${esc(name)}</div></div>`;
        }).join("")+`</div></div>`;
    }else if(state.drawerTab==="probabilities"){
      body=`<div class="drawer-section"><h4>Outcome probabilities</h4>`+
        [{k:"Home win",v:p.p_home,t:m.home},{k:"Draw",v:p.p_draw,t:""},{k:"Away win",v:p.p_away,t:m.away}].map(x=>`
        <div class="prob-row"><span>${esc(x.t||x.k)}</span><div class="bar-wrap"><div class="bar" style="width:${pct(x.v)};background:${barColor(x.v)}"></div></div><span>${pct(x.v)}</span></div>`).join("")+`</div>`;
      body+=`<div class="drawer-section"><h4>Expected score</h4><div class="accuracy-stat"><div class="v">${esc(p.predicted_score||"-")}</div><div class="k">Projected scoreline</div></div></div>`;
    }else if(state.drawerTab==="value"){
      const v=state.valueBets.find(x=>x.match_n===m.n);
      body=`<div class="drawer-section"><h4>Value assessment</h4>`+(v?`
        <div class="pc-body">
          <div class="pc-metric"><div class="pc-metric-label">Best side</div><div class="pc-metric-value">${esc(v.best_side)}</div></div>
          <div class="pc-metric"><div class="pc-metric-label">Edge</div><div class="pc-metric-value" style="color:${v.value_bet?'var(--success)':'var(--text-muted)'}">${v.edge_pp.toFixed(2)}pp</div></div>
          <div class="pc-metric"><div class="pc-metric-label">Model ${v.best_side} prob</div><div class="pc-metric-value">${pct(v.best_side==='home'?v.model_p_home:(v.best_side==='draw'?v.model_p_draw:v.model_p_away))}</div></div>
          <div class="pc-metric"><div class="pc-metric-label">Value bet</div><div class="pc-metric-value">${v.value_bet?"Yes":"No"}</div></div>
        </div>
        <p style="color:var(--text-secondary);margin-top:12px;">This compares the model probability to a devigged market sample. Positive edge does not mean the outcome is guaranteed.</p>`
        :`<p style="color:var(--text-secondary);">No value assessment available for this fixture.</p>`)+`</div>`;
    }else if(state.drawerTab==="lineups"){
      const homeInj=Object.entries(state.injuries).filter(([_,i])=>i.team===m.home).map(([name,i])=>`<li><b>${esc(name)}</b> (${esc(i.status)}) — ${esc(i.reason)}</li>`).join("");
      const awayInj=Object.entries(state.injuries).filter(([_,i])=>i.team===m.away).map(([name,i])=>`<li><b>${esc(name)}</b> (${esc(i.status)}) — ${esc(i.reason)}</li>`).join("");
      body=`<div class="drawer-section"><h4>${esc(m.home)} availability</h4>${homeInj||'<p style="color:var(--text-secondary);">No reported issues.</p>'}</div>`;
      body+=`<div class="drawer-section"><h4>${esc(m.away)} availability</h4>${awayInj||'<p style="color:var(--text-secondary);">No reported issues.</p>'}</div>`;
    }else if(state.drawerTab==="video"){
      const mv=matchVideo(m.n);
      body=`<div class="drawer-section"><h4>Match cinematic</h4>`;
      body+=`<video class="drawer-video" controls preload="metadata" poster="${matchAsset(m.n)}" onerror="this.classList.add('hidden');document.getElementById('vf-${m.n}').classList.remove('hidden')">${mv?`<source src="${mv}" type="video/mp4">`:''}</video>`;
      body+=`<div id="vf-${m.n}" class="${mv?'hidden':''}"><img src="${matchAsset(m.n)}" style="width:100%;border-radius:var(--radius-sm);border:1px solid var(--border);" alt=""><p style="color:var(--text-muted);font-size:12px;margin-top:8px;">Custom video not available for this fixture.</p></div>`;
      body+=`<p style="color:var(--text-muted);font-size:12px;margin-top:8px;">Custom generated video for this fixture. Falls back to the still image if processing.</p></div>`;
    }
    $("drawer-body").innerHTML=body;
  }

  // ── Simulator ─────────────────────────────────────────────────────────────
  function applyScenario(){
    const n=parseInt($("sim-match").value,10); const score=$("sim-score").value.trim();
    if(!n||!/^\d+\s*-\s*\d+$/.test(score)){ alert("Select a match and enter a score like 2-1."); return; }
    state.scenario[n]=score.replace(/\s/g,""); renderGroups();
  }
  function resetScenario(){ state.scenario={}; $("sim-score").value=""; renderGroups(); }

  // ── Mobile tray ───────────────────────────────────────────────────────────
  function toggleMobileTray(){ $("mobile-tray").classList.toggle("expanded"); }

  // ── View toggle ───────────────────────────────────────────────────────────
  function bindEvents(){
    document.querySelectorAll(".toggle-pill button").forEach(btn=>{
      btn.addEventListener("click",()=>{
        document.querySelectorAll(".toggle-pill button").forEach(b=>{b.classList.remove("active");b.setAttribute("aria-pressed","false");});
        btn.classList.add("active"); btn.setAttribute("aria-pressed","true"); state.view=btn.dataset.view; renderFeed(); renderKnockouts();
      });
    });
    $("player-search").addEventListener("input", renderPlayers);
    $("player-team-filter").addEventListener("change", renderPlayers);
    $("player-pos-filter").addEventListener("change", renderPlayers);
    document.addEventListener("keydown", e=>{ if(e.key==="Escape") closeDrawer(); });
  }

  window.JARVIS = {
    init, openDrawer, closeDrawer, setDrawerTab,
    addToBuilder, removeFromBuilder,
    applyScenario, resetScenario,
    showAllFixtures, toggleMobileTray
  };
  init();
})();
</script>
</body>
</html>
