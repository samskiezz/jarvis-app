  }
  .builder-drawer.show { transform: translateX(0); }
  .builder-header { padding: 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .builder-header h3 { margin: 0; font-size: 18px; }
  .builder-close { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--text-primary); cursor: pointer; font-size: 20px; }
  .builder-body { flex: 1; overflow-y: auto; padding: 20px; }
  .builder-empty { text-align: center; padding: 40px 20px; color: var(--text-muted); }
  .builder-selection {
    display: flex; align-items: center; gap: 12px;
    padding: 14px; margin-bottom: 10px;
    background: var(--surface-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .builder-selection .sel-text { flex: 1; }
  .builder-selection .sel-title { font-size: 14px; font-weight: 700; }
  .builder-selection .sel-meta { font-size: 11px; color: var(--text-muted); }
  .builder-selection .sel-remove {
    width: 28px; height: 28px; border-radius: 50%; border: none; background: rgba(255,77,79,0.15);
    color: var(--risk); cursor: pointer; font-size: 16px; line-height: 1;
  }
  .builder-warning {
    background: rgba(245,165,36,0.08); border: 1px solid rgba(245,165,36,0.2);
    border-radius: var(--radius-sm); padding: 12px; font-size: 12px; color: var(--warning); margin-bottom: 14px;
  }

  /* ── Match detail drawer ──────────────────────────────────────────────── */
  .drawer-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,0.65);
    backdrop-filter: blur(6px); z-index: 300; opacity: 0; pointer-events: none;
    transition: opacity .25s;
  }
  .drawer-backdrop.show { opacity: 1; pointer-events: auto; }
  .drawer {
    position: fixed; top: 0; right: 0; width: 560px; max-width: 100%; height: 100vh;
    background: linear-gradient(180deg, #0D1320 0%, #070A12 100%);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-strong);
    z-index: 310; transform: translateX(100%);
    transition: transform .3s cubic-bezier(.4,0,.2,1);
    display: flex; flex-direction: column;
  }
  .drawer.show { transform: translateX(0); }
  .drawer-header { padding: 18px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .drawer-header h2 { margin: 0; font-size: 18px; }
  .drawer-close { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--text-primary); cursor: pointer; font-size: 20px; }
  .drawer-tabs { display: flex; gap: 4px; padding: 10px 16px; border-bottom: 1px solid var(--border); overflow-x: auto; }
  .drawer-tab { padding: 8px 14px; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text-secondary); font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .drawer-tab.active { background: var(--surface-elevated); color: var(--accent); border-color: var(--border); }
  .drawer-body { flex: 1; overflow-y: auto; padding: 20px; }
  .drawer-section { margin-bottom: 24px; }
  .drawer-section h4 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .drawer-hero { height: 240px; border-radius: var(--radius); position: relative; overflow: hidden; border: 1px solid var(--border); margin-bottom: 20px; --card-img:none; }
  .drawer-hero::after { content: ""; position: absolute; inset: 0; background: var(--card-img) center/cover no-repeat; opacity: 0.35; }
  .drawer-hero-meta { position: absolute; top: 16px; left: 16px; z-index: 1; font-size: 11px; color: var(--text-secondary); background: rgba(0,0,0,0.45); padding: 5px 12px; border-radius: 999px; }
  .drawer-hero-score { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); font-family: var(--font-condensed); font-size: 72px; font-weight: 800; z-index: 1; text-shadow: 0 0 30px rgba(0,0,0,0.9); }
  .drawer-hero-pick { position: absolute; bottom: 16px; left: 16px; z-index: 1; font-size: 13px; }
  .drawer-video { width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--border); }
  .prob-row { display: flex; align-items: center; gap: 10px; margin: 8px 0; font-size: 13px; }
  .prob-row span:first-child { width: 90px; color: var(--text-secondary); }
  .prob-row span:last-child { width: 46px; text-align: right; font-weight: 700; }
  .bar-wrap { flex: 1; height: 8px; background: rgba(255,255,255,0.08); border-radius: 4px; overflow: hidden; }
  .bar { height: 100%; border-radius: 4px; }
  .pc-metric { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; }
  .pc-metric-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 6px; }
  .pc-metric-value { font-size: 20px; font-weight: 700; }

  /* ── Footer ───────────────────────────────────────────────────────────── */
  .app-footer {
    position: relative; overflow: hidden;
    padding: 48px 24px;
    border-top: 1px solid var(--border);
    background: rgba(7,10,18,0.9);
  }
  .footer-inner { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; }
  .footer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; margin-bottom: 28px; }
  .footer-col h4 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .footer-col a { display: block; color: var(--text-secondary); text-decoration: none; font-size: 12.5px; margin-bottom: 6px; }
  .footer-col a:hover { color: var(--accent); }
  .disclaimer {
    background: rgba(245,165,36,0.06); border: 1px solid rgba(245,165,36,0.2);
    border-radius: var(--radius); padding: 16px; font-size: 12px; color: var(--text-secondary); line-height: 1.6;
  }

  /* ── Toast / loading ──────────────────────────────────────────────────── */
  .toast { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 400; padding: 12px 20px; border-radius: var(--radius-sm); font-weight: 600; box-shadow: var(--shadow-strong); }
  .toast-risk { background: rgba(255,77,79,0.12); color: var(--risk); border: 1px solid rgba(255,77,79,0.25); }
  .toast a { color: inherit; text-decoration: underline; }
  .skeleton {
    position: relative; overflow: hidden;
    background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.05) 75%);
    background-size: 200% 100%; animation: shimmer 1.5s infinite;
    border-radius: 12px;
  }
  .state-box { position: relative; overflow: hidden; text-align: center; padding: 40px 20px; color: var(--text-muted); border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface-elevated); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .hero-video, .panel-video, .card-video, .lab-video, .fc-video { display: none; }
    .carousel-card:hover, .featured-card:hover, .bracket-match:hover { transform: none; }
    .scroll-indicator { animation: none; }
  }

  @media (min-width: 1100px) {
    .dock { top: 0; bottom: auto; border-top: none; border-bottom: 1px solid var(--border-strong); }
    .hero { padding-top: 140px; }
    .fab { bottom: 24px; }
    main { padding-bottom: 24px; padding-top: var(--dock-height); }
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: 20px; }
    .hero-stat .v { font-size: 28px; }
    .dock-item span { display: none; }
    .dock-inner { gap: 4px; }
    .dock-item { padding: 0 12px; }
    .fixture-row { grid-template-columns: 60px 1fr 80px; }
    .fixture-pick, .fixture-result { display: none; }
  }

  @media (max-width: 700px) {
    .hero { padding: 100px 18px 100px; }
    .hero-title { font-size: 42px; }
    .hero-subtitle { font-size: 15px; }
    .panel { padding: 44px 18px; }
    .prediction-card { width: 86vw; }
    .group-card, .news-card { width: 86vw; }
    .player-card { width: 80vw; }
    .drawer, .builder-drawer { width: 100%; }
    .carousel { margin: 0 -18px; padding-left: 18px; padding-right: 18px; }
  }
</style>
</head>
