  /* ── News cards ───────────────────────────────────────────────────────── */
  .news-card { width: 340px; min-height: 260px; display: flex; flex-direction: column; justify-content: flex-end; padding: 0; }
  .news-card .nc-content { padding: 18px; background: linear-gradient(180deg, transparent 0%, rgba(7,10,18,0.95) 60%); }
  .news-card .nc-match { font-size: 12px; font-weight: 700; color: var(--accent-glow); margin-bottom: 6px; }
