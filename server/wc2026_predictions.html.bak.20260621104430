<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content="Jarvis Match Centre — World Cup 2026 Prediction Intelligence. Live model predictions, score projections, risk ratings, late news and tournament impact." />
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self';" />
<title>Jarvis Match Centre · World Cup 2026 Prediction Intelligence</title>
<style>
  :root {
    --bg: #070A12;
    --surface: #101624;
    --surface-elevated: #151D2E;
    --surface-highlight: #1B2740;
    --border: rgba(255,255,255,0.08);
    --border-strong: rgba(255,255,255,0.14);
    --text-primary: #F7F9FC;
    --text-secondary: #AAB4C5;
    --text-muted: #6F7A8D;
    --accent: #2F80FF;
    --accent-glow: #00D5FF;
    --success: #35D07F;
    --warning: #F5A524;
    --risk: #FF4D4F;
    --shadow: 0 8px 32px rgba(0,0,0,0.45);
    --shadow-strong: 0 16px 48px rgba(0,0,0,0.55);
    --radius: 18px;
    --radius-sm: 12px;
    --font-primary: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --font-condensed: "Roboto Condensed", "Saira Condensed", Impact, sans-serif;
    --dock-height: 64px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes fadeIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    @keyframes glow { 0%,100% { box-shadow: 0 0 20px rgba(47,128,255,0.15); } 50% { box-shadow: 0 0 40px rgba(47,128,255,0.35); } }
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    @keyframes scrollBounce { 0%,100% { transform: translateY(0); opacity: .7; } 50% { transform: translateY(8px); opacity: 1; } }
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-primary);
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
    overflow-x: hidden;
  }

  ::-webkit-scrollbar { width: 8px; height: 10px; }
  ::-webkit-scrollbar-track { background: var(--surface); }
  ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 5px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .hidden { display:none !important; }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 100px 24px 120px;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(7,10,18,0.25) 0%, rgba(7,10,18,0.55) 45%, rgba(7,10,18,0.92) 100%),
      radial-gradient(circle at 20% 0%, rgba(47,128,255,0.25) 0%, transparent 40%),
      radial-gradient(circle at 80% 30%, rgba(0,213,255,0.18) 0%, transparent 35%),
      url('asset/mc_stadium_command_centre_bg.png');
    background-size: cover, cover, cover, cover;
    background-position: center;
    z-index: 0;
  }
  .hero-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0.55; pointer-events: none; z-index: 1;
  }
  .hero-grid {
    position: relative; z-index: 2;
    max-width: 1400px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px;
    align-items: end;
  }
  .hero-title {
    font-family: var(--font-condensed); font-size: clamp(48px, 9vw, 96px);
    line-height: 0.88; font-weight: 800; letter-spacing: -0.03em;
    margin: 0 0 14px; text-transform: uppercase;
    background: linear-gradient(180deg, #fff 0%, #8fbfff 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 24px rgba(47,128,255,0.25));
  }
  .hero-subtitle {
    font-size: clamp(16px, 2.2vw, 22px); color: var(--text-secondary);
    max-width: 620px; line-height: 1.5; margin-bottom: 28px;
  }
  .hero-badges { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border-radius: 999px; font-size: 12px; font-weight: 700;
    background: rgba(16,22,36,0.7); border: 1px solid var(--border-strong);
    backdrop-filter: blur(10px);
  }
  .hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); animation: pulse 2s infinite; }
  .hero-stats { display: flex; gap: 32px; }
  .hero-stat .v { font-family: var(--font-condensed); font-size: 36px; font-weight: 800; color: var(--accent-glow); }
  .hero-stat .k { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .scroll-indicator {
    position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
    z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    animation: scrollBounce 2s infinite; cursor: pointer;
  }
  .scroll-indicator svg { width: 24px; height: 24px; stroke: currentColor; stroke-width: 2; fill: none; }

  /* ── Featured next-match card ─────────────────────────────────────────── */
  .featured-card {
    position: relative;
    border-radius: var(--radius); overflow: hidden;
    background: var(--surface-elevated);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-strong);
    transform: translateY(0); transition: transform .3s, box-shadow .3s;
  }
  .featured-card:hover { transform: translateY(-6px); box-shadow: 0 24px 64px rgba(0,0,0,0.6), 0 0 40px rgba(47,128,255,0.12); }
  .featured-card .fc-bg {
    position: absolute; inset: 0; background: var(--card-img) center/cover no-repeat;
    opacity: 0.45; transition: opacity .35s; z-index: 0;
  }
  .featured-card:hover .fc-bg { opacity: 0.25; }
  .featured-card .fc-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity .4s; z-index: 1;
  }
  .featured-card:hover .fc-video { opacity: 0.6; }
  .featured-card > *:not(.fc-bg):not(.fc-video) { position: relative; z-index: 2; }
  .fc-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; border-bottom: 1px solid var(--border); background: rgba(7,10,18,0.35); backdrop-filter: blur(8px); }
  .fc-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-glow); }
  .fc-kickoff { font-size: 12px; color: var(--text-secondary); }
  .fc-body { padding: 22px 20px; text-align: center; }
  .fc-teams { display: flex; align-items: center; justify-content: center; gap: 18px; margin-bottom: 14px; }
  .fc-team { text-align: center; }
  .fc-team .flag { font-size: 52px; filter: drop-shadow(0 6px 12px rgba(0,0,0,0.4)); }
  .fc-team .name { font-size: 15px; font-weight: 700; margin-top: 6px; }
  .fc-team .code { font-size: 11px; color: var(--text-muted); }
  .fc-vs { font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  .fc-score { font-family: var(--font-condensed); font-size: 56px; font-weight: 800; margin: 8px 0; }
  .fc-pick { font-size: 13px; color: var(--text-secondary); }
  .fc-pick b { color: var(--text-primary); }
  .fc-footer { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: rgba(7,10,18,0.45); border-top: 1px solid var(--border); gap: 10px; }

  /* ── Dock ─────────────────────────────────────────────────────────────── */
  .dock {
    position: fixed; left: 0; right: 0; bottom: 0;
    z-index: 500;
    background: rgba(7,10,18,0.92);
    border-top: 1px solid var(--border-strong);
    backdrop-filter: blur(20px) saturate(180%);
    padding: 0 16px;
  }
  .dock-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: center; gap: 6px; height: var(--dock-height); }
  .dock-item {
    display: flex; align-items: center; gap: 8px;
    padding: 0 16px; border-radius: 999px;
    color: var(--text-muted); font-size: 12px; font-weight: 700;
    text-decoration: none; white-space: nowrap;
    transition: all .2s; border: 1px solid transparent;
    background: transparent; cursor: pointer;
  }
  .dock-item:hover { color: var(--text-primary); background: var(--surface-elevated); }
  .dock-item.active { color: var(--accent-glow); background: rgba(47,128,255,0.12); border-color: rgba(47,128,255,0.25); }
  .dock-item svg { width: 18px; height: 18px; }

  /* ── Layout & panels ──────────────────────────────────────────────────── */
  main { padding-bottom: calc(var(--dock-height) + 24px); }
  .panel {
    position: relative;
    padding: 64px 24px;
    border-top: 1px solid var(--border);
    overflow: hidden;
  }
  .panel:first-of-type { border-top: none; }
  .panel-bg {
    position: absolute; inset: 0; z-index: 0;
    background: var(--panel-img) center/cover no-repeat;
    opacity: 0.35;
  }
  .panel-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0.45; pointer-events: none; z-index: 1;
  }
  .panel::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(7,10,18,0.78) 0%, rgba(7,10,18,0.92) 60%, var(--bg) 100%);
    z-index: 2;
  }
  .panel-inner { position: relative; z-index: 3; max-width: 1400px; margin: 0 auto; }
  .panel-header { margin-bottom: 28px; }
  .panel-header h2 {
    font-family: var(--font-condensed); font-size: clamp(28px, 5vw, 48px);
    font-weight: 800; letter-spacing: -0.02em; text-transform: uppercase;
    margin: 0 0 8px;
  }
  .panel-header p { margin: 0; font-size: 14px; color: var(--text-secondary); max-width: 600px; }

  /* ── Carousels ────────────────────────────────────────────────────────── */
  .carousel {
    display: flex; gap: 18px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding: 24px;
    padding: 12px 4px 24px;
    margin: 0 -24px;
    padding-left: 24px; padding-right: 24px;
  }
  .carousel::-webkit-scrollbar { height: 6px; }
  .carousel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
  .carousel-card {
    flex: 0 0 auto;
    scroll-snap-align: start;
    position: relative;
    border-radius: var(--radius); overflow: hidden;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: transform .25s, box-shadow .25s, border-color .25s;
    cursor: pointer;
  }
  .carousel-card:hover { transform: translateY(-8px); border-color: var(--border-strong); box-shadow: 0 20px 50px rgba(0,0,0,0.55), 0 0 30px rgba(47,128,255,0.1); }
  .carousel-card .card-bg {
    position: absolute; inset: 0; background: var(--card-img) center/cover no-repeat;
    opacity: 0.42; transition: opacity .35s; z-index: 0;
  }
  .carousel-card:hover .card-bg { opacity: 0.22; }
  .carousel-card .card-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity .4s; z-index: 1;
  }
  .carousel-card:hover .card-video, .carousel-card:focus-within .card-video { opacity: 0.55; }
  .carousel-card > *:not(.card-bg):not(.card-video) { position: relative; z-index: 2; }

  /* ── Prediction cards ─────────────────────────────────────────────────── */
  .prediction-card {
    width: 320px; min-height: 420px;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 0;
  }
  .prediction-card.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 30px rgba(47,128,255,0.15); }
  .pc-top {
    padding: 18px 18px 0;
    display: flex; justify-content: space-between; align-items: flex-start;
  }
  .pc-meta { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; }
  .pc-center { padding: 28px 18px; text-align: center; }
  .pc-teams-row { display: flex; align-items: center; justify-content: center; gap: 18px; margin-bottom: 18px; }
  .pc-team-block { text-align: center; }
  .pc-team-block .flag { font-size: 56px; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.45)); }
  .pc-team-block .name { font-size: 16px; font-weight: 700; margin-top: 8px; }
  .pc-team-block .code { font-size: 11px; color: var(--text-muted); }
  .pc-vs-small { font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  .pc-score-big {
    font-family: var(--font-condensed); font-size: 64px; font-weight: 800;
    background: linear-gradient(180deg, #fff, #AAB4C5); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    line-height: 1; margin-bottom: 10px;
  }
  .pc-bottom { padding: 0 18px 18px; }
  .pc-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .pc-bar-label { font-size: 11px; color: var(--text-secondary); width: 70px; }
  .pc-bar-track { flex: 1; height: 6px; background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden; }
  .pc-bar-fill { height: 100%; border-radius: 3px; }
  .pc-bar-val { font-family: var(--font-mono); font-size: 12px; font-weight: 700; width: 40px; text-align: right; }
  .pc-actions-row { display: flex; gap: 10px; }

  /* ── Badges & buttons ─────────────────────────────────────────────────── */
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    background: rgba(53,208,127,0.12); color: var(--success); border: 1px solid rgba(53,208,127,0.25);
  }
  .risk-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700;
    border: 1px solid;
  }
  .risk-low { background: rgba(53,208,127,0.10); color: var(--success); border-color: rgba(53,208,127,0.25); }
  .risk-medium { background: rgba(245,165,36,0.10); color: var(--warning); border-color: rgba(245,165,36,0.25); }
  .risk-high { background: rgba(255,77,79,0.10); color: var(--risk); border-color: rgba(255,77,79,0.25); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 10px 16px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 700;
    border: 1px solid var(--border); background: rgba(16,22,36,0.85); color: var(--text-primary);
    cursor: pointer; transition: all .2s; backdrop-filter: blur(8px);
    flex: 1;
  }
  .btn:hover { background: var(--surface-highlight); border-color: var(--border-strong); }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-primary:hover { background: #1a6fd6; box-shadow: 0 0 20px rgba(47,128,255,0.25); }
  .btn-ghost { background: transparent; color: var(--text-secondary); flex: 0 0 auto; }
  .btn-ghost:hover { color: var(--text-primary); background: rgba(255,255,255,0.05); }
  .btn-sm { padding: 7px 12px; font-size: 11px; }
  .btn-icon { width: 36px; height: 36px; padding: 0; border-radius: 50%; flex: 0 0 auto; }
  .toggle-pill {
    display: flex; background: rgba(255,255,255,0.08); border: 1px solid var(--border); border-radius: 999px; padding: 3px;
  }
  .toggle-pill button {
    border: none; background: transparent; color: var(--text-secondary); font-size: 11px; font-weight: 700;
    padding: 5px 12px; border-radius: 999px; cursor: pointer;
  }
  .toggle-pill button.active { background: var(--accent); color: #fff; }

  /* ── Fixtures timeline ────────────────────────────────────────────────── */
  .timeline { max-width: 900px; }
  .timeline-stage { margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; background: var(--surface-elevated); }
  .timeline-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; cursor: pointer; background: rgba(255,255,255,0.02);
    border-bottom: 1px solid transparent; transition: border-color .2s;
  }
  .timeline-stage.open .timeline-header { border-bottom-color: var(--border); }
  .timeline-header h4 { margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); }
  .timeline-body { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
  .timeline-stage.open .timeline-body { max-height: 2000px; }
  .fixture-row {
    display: grid; grid-template-columns: 70px 1fr 110px 90px 90px;
    align-items: center; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    transition: background .15s; cursor: pointer;
  }
  .fixture-row:last-child { border-bottom: none; }
  .fixture-row:hover { background: rgba(255,255,255,0.03); }
  .fixture-time { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); }
  .fixture-match { display: flex; align-items: center; gap: 10px; font-weight: 700; }
  .fixture-pick { font-size: 11px; font-weight: 700; color: var(--text-secondary); }
  .fixture-score { font-family: var(--font-condensed); font-size: 18px; font-weight: 800; text-align: right; }
  .fixture-result { text-align: right; font-size: 11px; font-weight: 700; }
  .fixture-result.correct { color: var(--success); }
  .fixture-result.incorrect { color: var(--risk); }

  /* ── Group cards ──────────────────────────────────────────────────────── */
  .group-card { width: 340px; }
  .gc-header { padding: 16px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: rgba(7,10,18,0.35); }
  .gc-header h4 { margin: 0; font-size: 18px; font-weight: 800; }
  .gc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .gc-table th { text-align: left; padding: 10px 12px; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border); }
  .gc-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .gc-table tr:last-child td { border-bottom: none; }
  .gc-table .team { display: flex; align-items: center; gap: 8px; font-weight: 700; }
  .gc-table .flag { font-size: 20px; }
  .gc-table .pts { font-weight: 800; font-family: var(--font-mono); }
  .gc-table .q { color: var(--success); }
  .gc-table .e { color: var(--text-muted); }

  /* ── Simulator ────────────────────────────────────────────────────────── */
  .sim-bar {
    display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
    padding: 14px 16px; margin-bottom: 24px;
    background: var(--surface-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm);
  }
  .sim-bar select, .sim-bar input {
    background: var(--bg); border: 1px solid var(--border); color: var(--text-primary);
    padding: 9px 12px; border-radius: var(--radius-sm); font-size: 12px;
  }
  .sim-bar select { min-width: 220px; }

  /* ── Knockout bracket ─────────────────────────────────────────────────── */
  .bracket-carousel { display: flex; gap: 18px; overflow-x: auto; padding-bottom: 16px; }
  .bracket-round { min-width: 260px; }
  .bracket-round h5 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px; }
  .bracket-match {
    position: relative; overflow: hidden;
    background: var(--surface-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 14px; margin-bottom: 12px; cursor: pointer;
    transition: transform .2s, border-color .2s;
  }
  .bracket-match:hover { transform: translateY(-4px); border-color: var(--border-strong); }
  .bracket-team { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; }
  .bracket-team.winner { color: var(--success); font-weight: 800; }
  .bracket-prob { font-family: var(--font-mono); color: var(--text-muted); font-size: 11px; }
  .bracket-pick { margin-top: 8px; font-size: 11px; color: var(--text-secondary); }

  /* ── Player cards ─────────────────────────────────────────────────────── */
  .player-card { width: 280px; padding: 18px; }
  .player-card .ph { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
  .player-name { font-size: 18px; font-weight: 800; }
  .player-team { font-size: 12px; color: var(--text-secondary); }
  .player-status { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 4px 10px; border-radius: 999px; border: 1px solid; }
  .player-status.ok { color: var(--success); border-color: rgba(53,208,127,0.3); background: rgba(53,208,127,0.08); }
  .player-status.doubt { color: var(--warning); border-color: rgba(245,165,36,0.3); background: rgba(245,165,36,0.08); }
  .player-status.out { color: var(--risk); border-color: rgba(255,77,79,0.3); background: rgba(255,77,79,0.08); }
