  .lab-card .lab-big { font-family: var(--font-condensed); font-size: 48px; font-weight: 800; color: var(--accent-glow); line-height: 1; }
  .lab-card h4 { margin: 8px 0 6px; font-size: 15px; }
  .lab-card p { margin: 0; font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
  .accuracy-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-top: 20px; }
  .accuracy-stat {
    position: relative; overflow: hidden;
