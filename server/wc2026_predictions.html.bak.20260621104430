  /* ── Model Lab ────────────────────────────────────────────────────────── */
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .lab-card {
    position: relative; overflow: hidden;
    min-height: 220px; padding: 22px;
