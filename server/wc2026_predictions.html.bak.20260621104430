    padding: 18px; text-align: center;
  }
  .accuracy-stat .v { font-size: 28px; font-weight: 800; font-family: var(--font-condensed); }
  .accuracy-stat .k { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 6px; }

  /* ── Builder FAB & drawer ─────────────────────────────────────────────── */
  .fab {
    position: fixed; right: 24px; bottom: calc(var(--dock-height) + 20px);
    z-index: 450;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--accent); color: #fff; border: none;
